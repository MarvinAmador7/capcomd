{
  "$comment": "DRAFT, not applied to openapi/capcomd.json. The harness.v1 additions the plugin API needs (docs/spec/plugin-api.md §9.9, §13.2). GET /v1/plugins moved into src/api/contract.ts with ADR-023 step 1 (its PluginSummary is the contract's now; the copy below is kept for PluginDetail); as the later steps land, the other routes move the same way and scripts/gen-harness-contract.ts regenerates the committed contract; this file is then deleted. Capability names: `plugins` (the listing and controls) and `plugins.protocol` (the out-of-process routes).",
  "openapi": "3.1.1",
  "info": { "title": "capcomd harness API: plugin additions (draft)", "version": "harness.v1" },
  "x-capabilities": {
    "plugins": "GET /v1/plugins and /v1/plugins/{name} (the read scope): every plugin the daemon knows, its state, cause, hooks, seams and call stats; POST /v1/plugins/{name}/enable and /disable (the configure scope, an Idempotency-Key) re-run or stop one plugin's lifecycle. plugin.* events on the daemon stream (and plugin.gate_denied / plugin.gate_bypassed on run streams) audit the host",
    "plugins.protocol": "The out-of-process plugin protocol, version 1: POST /v1/plugins/{name}/sessions, GET /v1/plugins/{name}/hooks (SSE), POST /v1/plugins/{name}/hooks/{callId}, POST /v1/plugins/{name}/events and the /v1/plugins/{name}/storage routes. Only the token the host minted for that plugin may call them (403 otherwise)"
  },
  "paths": {
    "/v1/plugins/{name}": {
      "get": {
        "operationId": "plugins.get",
        "description": "Capability plugins. One plugin: its summary, its manifest as validated, and its layered config with every `x-secret` property removed and each value's source (default, user, project, env). Needs the read scope. 404 not_found for a name the daemon did not discover.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PluginDetail" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/plugins/{name}/enable": {
      "post": {
        "operationId": "plugins.enable",
        "description": "Capability plugins. Re-run the plugin's lifecycle from `validated` (§5.5): resolve, load, activate; also resets a tripped breaker (plugin.resumed). Needs the configure scope and an Idempotency-Key (8-200 chars; scoped to the client, kept 24 h). Answers when the plugin is active or failed, within 60 s; 409 conflict while another enable or disable of it is under way. Writes `plugins.<name>.enabled: true` to the user config.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PluginSummary" } } } }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/plugins/{name}/disable": {
      "post": {
        "operationId": "plugins.disable",
        "description": "Capability plugins. Dispose the plugin (§5.4 disposing → disposed, cause disabled) and keep it disabled across restarts (`plugins.<name>.enabled: false` in the user config). Needs the configure scope and an Idempotency-Key. A plugin that implements the sandbox seam a running agent uses is refused with 409 conflict and the agents named; cancel them first. A built-in may be disabled unless the kernel marks it required (today none).",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PluginSummary" } } } }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/plugins/{name}/sessions": {
      "post": {
        "operationId": "plugins.sessions.open",
        "description": "Capability plugins.protocol. The handshake (§9.3). The process the host started presents the session id from CAPCOMD_PLUGIN_SESSION, the protocol version it speaks, the sha256 of the manifest it was started from and the hooks it will answer. Only the plugin's own minted token (any scope) may call it: 403 forbidden for any other client. 409 conflict for a session id the host did not issue, an already-open session, or a manifest hash that is not the loaded manifest's; 422 invalid for a protocol the host does not speak or a hook list that is not exactly contributes.hooks. Answers with the config (secret properties removed), the secret values once, the hook deadlines and how soon the hooks stream must be open.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionOpen" } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionOpened" } } } }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/plugins/{name}/hooks": {
      "get": {
        "operationId": "plugins.hooks.stream",
        "description": "Capability plugins.protocol. The hook stream (§9.4): SSE, one frame per hook call (`event: hook.call`, `id: <seq>`, `data: HookFrame`), plus `hook.dropped` and `session.closing`. Only the plugin's own token may open it, for an open session (`session` query; 409 conflict otherwise). One stream per session: opening a second closes the first with session.closing reason replaced. Resume with Last-Event-ID: gate calls still open are re-sent, observe frames since are replayed from a 1000-frame buffer, older ones are counted in a hook.dropped frame. Heartbeat comments every 15 s.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "name": "session", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "The stream", "content": { "text/event-stream": { "schema": { "$ref": "#/components/schemas/HookFrame" } } } }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/plugins/{name}/hooks/{callId}": {
      "post": {
        "operationId": "plugins.hooks.answer",
        "description": "Capability plugins.protocol. Answer one hook call (§9.4) before its deadline. Only the plugin's own token, for the session the call was sent to. 204 when the answer was taken; also 204 for an observe call (no answer is needed, one is accepted). 404 not_found for a callId the host did not send to this session; 409 conflict when the call was already answered or its deadline passed (the host applied the failure policy; the plugin should log it and move on); 422 invalid when the result's shape does not match the hook's mode (a veto answering with a patch, a modify patching a field it may not) or, for a modify hook, when the patch widens: `message` names the field, and the host treats the call as failed with kind invalid_result.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "name": "callId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HookAnswer" } } } },
        "responses": { "204": { "description": "Taken" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/plugins/{name}/events": {
      "post": {
        "operationId": "plugins.events.emit",
        "description": "Capability plugins.protocol. `ctx.events.emit` over the wire (§9.6): a durable (default) or ephemeral event of type `plugin.<name>.<type>` on the daemon stream or a run's. Only the plugin's own token; `type` must be in contributes.events (422 invalid otherwise); `data` is redacted and capped at 64 KB; `text` is the plugin's own sentence. Needs an Idempotency-Key (same key, same body: the first seq is returned). 404 not_found for a run that does not exist.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmitBody" } } } },
        "responses": { "201": { "description": "Emitted", "content": { "application/json": { "schema": { "type": "object", "required": ["seq"], "properties": { "seq": { "type": "integer" } } } } } }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/plugins/{name}/storage": {
      "get": {
        "operationId": "plugins.storage.list",
        "description": "Capability plugins.protocol. `ctx.storage.list` (§9.6): the plugin's own keys under `prefix`, in the daemon scope or, with `run`, that run's. Only the plugin's own token (the storage is private to it: another plugin's token is 403 forbidden).",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "name": "prefix", "in": "query", "schema": { "type": "string" } }, { "name": "run", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "required": ["entries"], "properties": { "entries": { "type": "array", "items": { "$ref": "#/components/schemas/StorageEntry" } } } } } } }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/plugins/{name}/storage/{key}": {
      "get": {
        "operationId": "plugins.storage.get",
        "description": "Capability plugins.protocol. `ctx.storage.get`. Only the plugin's own token. 404 not_found when the key is unset.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "name": "key", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/StorageKey" } }, { "name": "run", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StorageEntry" } } } }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      },
      "put": {
        "operationId": "plugins.storage.put",
        "description": "Capability plugins.protocol. `ctx.storage.put` and `cas`: with `expect` (the JSON text of the current value, or null for must-not-exist) the write is a compare-and-swap and a mismatch is 409 conflict with the current entry. Values are JSON at most 64 KB (422 invalid beyond). Only the plugin's own token. Keys of a run scope are deleted with the run.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "name": "key", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/StorageKey" } }, { "name": "run", "in": "query", "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StoragePutBody" } } } },
        "responses": { "200": { "description": "Written", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StorageEntry" } } } }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "plugins.storage.delete",
        "description": "Capability plugins.protocol. `ctx.storage.delete`. Only the plugin's own token. Deleting an unset key is 204 too.",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/PluginName" } }, { "name": "key", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/StorageKey" } }, { "name": "run", "in": "query", "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 200 }, "description": "Scoped to the calling client; kept 24 h. Same key + same body replays the first response; same key + different body: 409 idempotency_conflict" }
    },
    "responses": {
      "Error": { "description": "Every non-2xx body is harness.v1 ApiError {code, message}", "content": { "application/json": { "schema": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } } }
    },
    "schemas": {
      "PluginName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "HookName": { "type": "string", "enum": ["daemon.started", "daemon.stopping", "run.creating", "run.changed", "profile.resolved", "agent.spawning", "agent.preparing", "agent.changed", "agent.item", "sandbox.ensuring", "sandbox.changed", "verify.starting", "verify.judging", "verify.changed", "merge.landing", "merge.changed", "approval.deciding", "approval.changed", "job.changed", "trigger.admitting", "trigger.changed"] },
      "PluginState": { "type": "string", "enum": ["discovered", "validated", "resolved", "loading", "active", "disposing", "disposed", "failed"], "description": "Spec §5.4. Treat a state you don't know as failed" },
      "PluginSummary": {
        "type": "object",
        "required": ["name", "version", "apiVersion", "runtime", "source", "state", "enabled", "cause", "hooks", "seams", "hooksSuspended", "stats"],
        "properties": {
          "name": { "$ref": "#/components/schemas/PluginName" },
          "version": { "type": "string" },
          "apiVersion": { "type": "integer", "const": 1 },
          "runtime": { "type": "string", "enum": ["in-process", "process"] },
          "source": { "type": "string", "enum": ["builtin", "user", "project"] },
          "state": { "$ref": "#/components/schemas/PluginState" },
          "enabled": { "type": "boolean", "description": "false when `plugins.<name>.enabled` is false in config, or a project plugin is untrusted" },
          "cause": { "type": ["string", "null"], "description": "Why it is failed, disposed or not enabled (spec §5.4 PluginFailureCause); null while active" },
          "hooks": { "type": "array", "items": { "$ref": "#/components/schemas/HookName" } },
          "seams": { "type": "array", "items": { "type": "object", "required": ["kind", "name"], "properties": { "kind": { "type": "string", "enum": ["sandbox", "agent", "forge"] }, "name": { "type": "string" } } } },
          "hooksSuspended": { "type": "boolean", "description": "The breaker tripped (plugin.suspended): listeners are not called; gate listeners count as deny" },
          "stats": { "type": "object", "required": ["calls", "failures", "dropped", "p50Ms", "p95Ms", "lastFailureAt"], "properties": { "calls": { "type": "integer" }, "failures": { "type": "integer" }, "dropped": { "type": "integer" }, "p50Ms": { "type": ["number", "null"] }, "p95Ms": { "type": ["number", "null"] }, "lastFailureAt": { "type": ["string", "null"] } } }
        }
      },
      "PluginDetail": {
        "allOf": [{ "$ref": "#/components/schemas/PluginSummary" }, { "type": "object", "required": ["manifest", "config"], "properties": { "manifest": { "type": "object", "description": "The validated manifest (capcomd.plugin/v1)" }, "config": { "type": "object", "required": ["values", "sources"], "properties": { "values": { "type": "object", "description": "Layered config, secret properties removed" }, "sources": { "type": "object", "additionalProperties": { "type": "string", "enum": ["default", "user", "project", "env"] } } } } } }]
      },
      "SessionOpen": {
        "type": "object", "required": ["session", "protocol", "manifestHash", "pid", "hooks"],
        "properties": { "session": { "type": "string" }, "protocol": { "type": "integer", "const": 1 }, "manifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "pid": { "type": "integer" }, "hooks": { "type": "array", "items": { "$ref": "#/components/schemas/HookName" } } }
      },
      "SessionOpened": {
        "type": "object", "required": ["session", "protocol", "plugin", "config", "secrets", "hookTimeoutsMs", "connectWithinMs", "daemon"],
        "properties": {
          "session": { "type": "string" }, "protocol": { "type": "integer", "const": 1 },
          "plugin": { "type": "object", "required": ["name", "version", "scopes"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "scopes": { "type": "array", "items": { "type": "string", "enum": ["read", "steer", "configure"] } } } },
          "config": { "type": "object", "description": "Layered and validated, secret properties removed" },
          "secrets": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Values of the `x-secret` properties, delivered once over the 0600 socket; never logged, never in events" },
          "hookTimeoutsMs": { "type": "object", "additionalProperties": { "type": "integer" } },
          "connectWithinMs": { "type": "integer", "description": "The hooks stream must be open within this, else the host restarts the process (§9.5)" },
          "daemon": { "type": "object", "required": ["version", "capabilities"], "properties": { "version": { "type": "string" }, "capabilities": { "type": "array", "items": { "type": "string" } } } }
        }
      },
      "HookCall": {
        "type": "object", "required": ["callId", "hook", "mode", "payloadVersion", "idempotencyKey", "deadline", "trace", "principal", "runId", "agentId", "at", "payload"],
        "properties": {
          "callId": { "type": "string" }, "hook": { "$ref": "#/components/schemas/HookName" }, "mode": { "type": "string", "enum": ["observe", "veto", "modify"] }, "payloadVersion": { "type": "integer", "const": 1 },
          "idempotencyKey": { "type": "string", "description": "Stable across kernel replays of the same decision (§6.7)" },
          "deadline": { "type": "string", "format": "date-time", "description": "Absolute; after it the host applies the failure policy" },
          "trace": { "type": "object", "required": ["traceId", "spanId"], "properties": { "traceId": { "type": "string" }, "spanId": { "type": "string" } } },
          "principal": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["operator", "driver", "agent", "viewer", "plugin"] } } },
          "runId": { "type": ["string", "null"] }, "agentId": { "type": ["string", "null"] }, "at": { "type": "string", "format": "date-time" },
          "deprecated": { "type": "object", "properties": { "since": { "type": "string" }, "replacement": { "type": ["string", "null"] } } },
          "payload": { "type": "object", "description": "The hook's payload (spec §6.6); agent-written text inside is {text, untrusted: true, by}" }
        }
      },
      "HookFrame": {
        "oneOf": [
          { "type": "object", "required": ["frame", "seq", "call"], "properties": { "frame": { "const": "hook.call" }, "seq": { "type": "integer" }, "call": { "$ref": "#/components/schemas/HookCall" } } },
          { "type": "object", "required": ["frame", "seq", "count", "hooks"], "properties": { "frame": { "const": "hook.dropped" }, "seq": { "type": "integer" }, "count": { "type": "integer" }, "hooks": { "type": "array", "items": { "$ref": "#/components/schemas/HookName" } } } },
          { "type": "object", "required": ["frame", "seq", "reason"], "properties": { "frame": { "const": "session.closing" }, "seq": { "type": "integer" }, "reason": { "type": "string", "enum": ["daemon_stopping", "disabled", "replaced"] } } }
        ]
      },
      "HookAnswer": {
        "type": "object", "required": ["session", "result"],
        "properties": {
          "session": { "type": "string" },
          "result": {
            "oneOf": [
              { "type": "object", "required": ["decision"], "properties": { "decision": { "const": "allow" }, "patch": { "type": "object", "description": "modify hooks only: the hook's patch type (spec §6.6)" } } },
              { "type": "object", "required": ["decision", "reason"], "properties": { "decision": { "const": "deny" }, "reason": { "type": "string", "maxLength": 500 }, "reasons": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } } } },
              { "type": "object", "required": ["decision", "reason"], "properties": { "decision": { "const": "hold" }, "reason": { "type": "string", "maxLength": 500 } }, "description": "merge.landing only: park the merge for a human approval" }
            ]
          }
        }
      },
      "EmitBody": {
        "type": "object", "required": ["type", "stream", "entity", "text", "data"],
        "properties": { "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Without the plugin prefix; must be in contributes.events" }, "stream": { "type": "string", "description": "daemon or a run id" }, "entity": { "type": "string" }, "text": { "type": "string", "maxLength": 500 }, "data": { "type": "object" }, "durability": { "type": "string", "enum": ["durable", "ephemeral"], "default": "durable" } }
      },
      "StorageKey": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,199}$" },
      "StoragePutBody": { "type": "object", "required": ["value"], "properties": { "value": {}, "expect": { "type": ["string", "null"], "description": "For a compare-and-swap: the JSON text of the expected current value; null for must-not-exist; absent for an unconditional write" } } },
      "StorageEntry": { "type": "object", "required": ["key", "value", "rev"], "properties": { "key": { "$ref": "#/components/schemas/StorageKey" }, "value": {}, "rev": { "type": "string", "description": "Changes with every write" } } }
    }
  },
  "x-events": {
    "plugin.loaded": { "stream": "daemon", "data": { "plugin": "string", "version": "string", "runtime": "in-process | process", "hooks": "HookName[]", "seams": "string[]", "ms": "integer" } },
    "plugin.failed": { "stream": "daemon", "data": { "plugin": "string", "version": "string | null", "cause": "PluginFailureCause", "message": "string" } },
    "plugin.disposed": { "stream": "daemon", "data": { "plugin": "string", "cause": "daemon_stopping | disabled | breaker | replaced | failed" } },
    "plugin.version_refused": { "stream": "daemon", "data": { "plugin": "string", "version": "string", "engines": "string", "capcomd": "string", "apiVersion": "integer" } },
    "plugin.duplicate_refused": { "stream": "daemon", "data": { "plugin": "string", "kept": "builtin | user | project", "refused": "builtin | user | project", "path": "string" } },
    "plugin.config_invalid": { "stream": "daemon", "data": { "plugin": "string", "errors": "[{path, message}]", "layer": "user | project | env | run" } },
    "plugin.hook_failed": { "stream": "daemon", "data": { "plugin": "string", "hook": "HookName", "callId": "string", "kind": "timeout | threw | crashed | invalid_result | disconnected | suspended", "message": "string", "effect": "denied | skipped" } },
    "plugin.suspended": { "stream": "daemon", "data": { "plugin": "string", "failures": "integer", "lastHook": "HookName" } },
    "plugin.resumed": { "stream": "daemon", "data": { "plugin": "string", "by": "string" } },
    "plugin.gate_denied": { "stream": "run", "data": { "plugin": "string", "hook": "HookName", "entity": "string", "decision": "deny | hold", "reason": "string (untrusted: the plugin's)" } },
    "plugin.gate_bypassed": { "stream": "run", "data": { "hook": "merge.landing", "entity": "string", "by": "string", "plugins": "[{plugin, reason}]" } },
    "plugin.deprecation": { "stream": "daemon", "data": { "plugin": "string", "hook": "HookName", "since": "string", "replacement": "HookName | null" } },
    "plugin.process": { "stream": "daemon", "data": { "plugin": "string", "event": "started | disconnected | reconnected | exited | restarting", "pid": "integer | null", "code": "integer | null", "restarts": "integer" } },
    "plugin.trusted": { "stream": "daemon", "data": { "plugin": "string", "source": "project", "hash": "string", "by": "string" } }
  }
}
