{
  "info": {
    "title": "capcomd harness API",
    "version": "harness.v1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/v1/runs": {
      "get": {
        "operationId": "runs.list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "projectId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "label": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "state": {
                        "type": "string"
                      },
                      "goal": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "projectId",
                      "label",
                      "state",
                      "goal"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}": {
      "get": {
        "operationId": "runs.get",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "projectId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "label": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "state": {
                      "type": "string"
                    },
                    "goal": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "projectId",
                    "label",
                    "state",
                    "goal"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}/agents": {
      "get": {
        "operationId": "agents.tree",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "runId": {
                        "type": "string"
                      },
                      "parent": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "depth": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "profile": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "status": {
                        "enum": [
                          "pending",
                          "running",
                          "paused",
                          "done",
                          "failed",
                          "cancelled",
                          "handed-off"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "runId",
                      "parent",
                      "depth",
                      "profile",
                      "status"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "events.replay",
        "description": "Durable events after `after` (resume cursor = seq). The live SSE stream uses the same envelope.",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "allowEmptyValue": true,
            "allowReserved": true
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "allowEmptyValue": true,
            "allowReserved": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "v": {
                        "const": 1
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^evt_"
                      },
                      "scope": {
                        "type": "string",
                        "pattern": "^(run-|prj-|daemon$)"
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "entity": {
                        "type": "string",
                        "minLength": 1
                      },
                      "entitySeq": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "type": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                      },
                      "typeVersion": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991,
                        "exclusiveMinimum": 0
                      },
                      "durability": {
                        "enum": [
                          "durable",
                          "ephemeral"
                        ],
                        "type": "string"
                      },
                      "ts": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "epochMs": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "projectId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "runId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "agentId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "data": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "v",
                      "id",
                      "scope",
                      "seq",
                      "entity",
                      "entitySeq",
                      "type",
                      "typeVersion",
                      "durability",
                      "ts",
                      "epochMs",
                      "projectId",
                      "runId",
                      "agentId",
                      "data"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/approvals/{approvalId}/decision": {
      "post": {
        "operationId": "approvals.decide",
        "description": "Idempotent: deciding again returns the first decision unchanged. No prior read needed.",
        "parameters": [
          {
            "name": "approvalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^apr-[A-Za-z0-9]+$",
              "description": "Stable approval id, carried on approval events; decide with it directly"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "decision": {
                    "enum": [
                      "approve",
                      "deny"
                    ],
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "decision"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approvalId": {
                      "type": "string",
                      "pattern": "^apr-[A-Za-z0-9]+$",
                      "description": "Stable approval id, carried on approval events; decide with it directly"
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "approved",
                        "denied",
                        "expired",
                        "withdrawn"
                      ],
                      "type": "string"
                    },
                    "decidedBy": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "clientId": {
                              "type": "string"
                            },
                            "principal": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "clientId",
                            "principal"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "decidedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reason": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "approvalId",
                    "status",
                    "decidedBy",
                    "decidedAt",
                    "reason"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
