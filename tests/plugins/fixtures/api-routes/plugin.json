{
  "schema": "capcomd.plugin/v1",
  "name": "api-routes",
  "version": "1.0.0",
  "description": "Test plugin (tests/api/plugin-routes.test.ts): API routes under /v1/x/api-routes that answer with what they were given and who called, throw, answer with a stream, take a body or never answer, and a feature flag.",
  "apiVersion": 1,
  "engines": {
    "capcomd": ">=0.0.0"
  },
  "entry": {
    "runtime": "in-process",
    "module": "./index.ts"
  },
  "contributes": {
    "api": [
      { "method": "GET", "path": "/echo/{id}", "scope": "read" },
      { "method": "GET", "path": "/echo/latest", "scope": "read" },
      { "method": "GET", "path": "/pair/{a}/{a}", "scope": "read" },
      { "method": "GET", "path": "/pair/one/{b}", "scope": "read" },
      { "method": "POST", "path": "/items", "scope": "steer" },
      { "method": "POST", "path": "/fail/{code}", "scope": "steer" },
      { "method": "GET", "path": "/boom", "scope": "read" },
      { "method": "GET", "path": "/stream", "scope": "read" },
      { "method": "DELETE", "path": "/items/{id}", "scope": "configure" },
      { "method": "GET", "path": "/symbol", "scope": "read" },
      { "method": "PUT", "path": "/blob", "scope": "steer" },
      { "method": "GET", "path": "/slow", "scope": "read" }
    ]
  }
}
