{
  "schema": "capcomd.plugin/v1",
  "name": "hook-recorder",
  "version": "1.0.0",
  "description": "Test plugin: records every hook call the kernel makes, in order, to the file CAPCOMD_TEST_HOOK_LOG names, and allows everything.",
  "apiVersion": 1,
  "engines": {
    "capcomd": ">=0.0.0"
  },
  "entry": {
    "runtime": "in-process",
    "module": "./index.ts"
  },
  "contributes": {
    "hooks": {
      "daemon.started": {},
      "daemon.stopping": {},
      "run.creating": {},
      "run.changed": {},
      "profile.resolved": {},
      "agent.spawning": {},
      "agent.preparing": {},
      "agent.changed": {},
      "agent.item": {},
      "sandbox.ensuring": {},
      "sandbox.changed": {},
      "verify.starting": {},
      "verify.judging": {},
      "verify.changed": {},
      "merge.landing": {},
      "merge.changed": {},
      "approval.deciding": {},
      "approval.changed": {},
      "job.changed": {},
      "trigger.admitting": {},
      "trigger.changed": {}
    }
  }
}
