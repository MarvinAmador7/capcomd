{
  "name": "capcomd",
  "version": "0.6.0",
  "description": "Durable orchestration for swarms of coding agents, driven by your agent: Claude Code and Codex in isolated VMs, landing only verified, reviewed commits",
  "keywords": [
    "agents",
    "orchestration",
    "claude-code",
    "codex",
    "ai-agents",
    "sandbox",
    "rivet",
    "cli"
  ],
  "license": "MIT",
  "author": "Marvin Amador Campos (https://github.com/MarvinAmador7)",
  "homepage": "https://github.com/MarvinAmador7/capcomd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarvinAmador7/capcomd.git"
  },
  "bugs": {
    "url": "https://github.com/MarvinAmador7/capcomd/issues"
  },
  "type": "module",
  "bin": {
    "capcomd": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "apps/tui/src",
    "packages/agent-thread/src",
    "plugins",
    "docs/*.md",
    "docs/upstream",
    "README.md",
    "LICENSE",
    "STATUS.md",
    "ROADMAP.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "setup": "bun install && cd apps/canvas && bun install && cd ../tui && bun install",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/canvas && tsc --noEmit -p apps/tui && tsc --noEmit -p packages/agent-thread && tsc --noEmit -p packages/bot-avatar",
    "test": "bun test",
    "test:chaos": "bun test tests/chaos/*.test.ts",
    "chaos:fast": "bun tests/chaos/fast.ts",
    "chaos:slow": "bun test tests/chaos/subprocess.test.ts",
    "test:fast": "bun test packages/agent-thread packages/bot-avatar tests/api tests/machines tests/config tests/unit tests/cli tests/tracing tests/core tests/auth tests/env tests/mcp tests/providers",
    "test:scenarios": "bun test tests/scenarios tests/subagents tests/primitives/policy.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.64.1",
    "typescript": "^7"
  },
  "dependencies": {
    "@boxd-sh/sdk": "0.2.18",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@orpc/contract": "^1.16.1",
    "@orpc/openapi": "^1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "^1.16.1",
    "@rivetkit/engine-cli": "2.3.31",
    "@xyflow/react": "^12.12.0",
    "commander": "^15.0.0",
    "elkjs": "^0.12.0",
    "hono": "4.13.13",
    "ink": "6",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rivetkit": "2.3.31",
    "string-width": "8.2.0",
    "xstate": "5.33.3",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
