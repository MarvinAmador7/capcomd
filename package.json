{
  "name": "capcomd",
  "version": "0.2.0",
  "description": "capcomd: agent orchestration CLI built on Rivet Actors",
  "type": "module",
  "private": true,
  "bin": {
    "capcomd": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "README.md",
    "STATUS.md",
    "ROADMAP.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "setup": "bun install && cd apps/canvas && bun install && cd ../tui && bun install",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/canvas && tsc --noEmit -p apps/tui",
    "test": "bun test",
    "test:chaos": "bun test tests/chaos/*.test.ts",
    "chaos:fast": "bun tests/chaos/fast.ts",
    "chaos:slow": "bun test tests/chaos/subprocess.test.ts",
    "test:scenarios": "bun test tests/scenarios tests/subagents tests/primitives/policy.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.64.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@boxd-sh/sdk": "0.2.18",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xyflow/react": "^12.12.0",
    "commander": "^15.0.0",
    "elkjs": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rivetkit": "2.3.27",
    "xstate": "5.33.3",
    "zod": "^4.6.7"
  }
}
